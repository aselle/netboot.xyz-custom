#!ipxe

:custom

set debian_version bookworm
set arch amd64
set mirror http://deb.debian.org/debian

set dir ${mirror}/dists/${debian_version}/main/installer-${arch}/current/images/netboot/debian-installer/${arch}

kernel ${dir}/linux auto=true priority=critical vga=788 mirror/http/hostname=deb.debian.org mirror/http/directory=/debian mirror/suite=${debian_version} quiet initrd=initrd.gz
initrd ${dir}/initrd.gz
boot
